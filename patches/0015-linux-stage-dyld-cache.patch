+    func testFsyncFailureStopsPublication() throws {
+        let f = try fixture()
+        try modify(f)
+        f.faults.sync = { descriptor in
+            var metadata = stat()
+            if fstat(descriptor, &metadata) == 0, metadata.st_mode & S_IFMT == S_IFREG { errno = EIO; return -1 }
+            return Glibc.fsync(descriptor)
