     }
     return true;
 }
@@ -4052,7 +4130,7 @@ static bool trans_LDAPR(DisasContext *s, arg_LDAPR *a)
      */
     do_gpr_ld(s, cpu_reg(s, a->rt), clean_addr, mop, false,
               true, a->rt, iss_sf, true);
-    tcg_gen_mb(TCG_MO_ALL | TCG_BAR_LDAQ);
