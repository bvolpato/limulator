     gen_load_exclusive(s, a->rt, a->rt2, a->rn, a->sz, false);
     if (a->lasr) {
-        tcg_gen_mb(TCG_MO_ALL | TCG_BAR_LDAQ);
+        vphone_acq_after(s);
