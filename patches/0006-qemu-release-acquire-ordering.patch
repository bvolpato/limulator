# Ported from vphone-linux QEMU commit 38c32a9bf16d92c0fd1d82b20c051cbe34a90372.
# Retains VPHONE_FENCE=0 and ports only acquire/release barrier mapping.
# Diagnostic instruction counters and unrelated development changes are excluded.
diff --git a/target/arm/tcg/translate-a64.c b/target/arm/tcg/translate-a64.c
index 209d037927..594ffd5ad4 100644
--- a/target/arm/tcg/translate-a64.c
+++ b/target/arm/tcg/translate-a64.c
