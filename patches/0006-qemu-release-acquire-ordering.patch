-    tcg_gen_mb(TCG_MO_ALL | TCG_BAR_STRL);
+    vphone_rel_before(s);
     memop = check_ordered_align(s, a->rn, 0, true, a->sz);
     clean_addr = gen_mte_check1(s, cpu_reg_sp(s, a->rn),
                                 true, a->rn != 31, memop);
     do_gpr_st(s, cpu_reg(s, a->rt), clean_addr, memop, true, a->rt,
               iss_sf, a->lasr);
+    vphone_rel_after(s);
     return true;
 }
 
