diff --git a/setup/create-vm.sh b/setup/create-vm.sh
--- a/setup/create-vm.sh
+++ b/setup/create-vm.sh
@@ -471,7 +471,11 @@ boot_vm() {
   if running_vm; then
     log "  this VM is already running (QEMU pid $QEMU_PID): waiting for vphoned"
   else
-    GFX=${GFX:-1} WINDOW=${WINDOW:-1} CID=$CID "$QEMU_RUN" "$VM" > "$VM/serial.log" 2>&1 &
