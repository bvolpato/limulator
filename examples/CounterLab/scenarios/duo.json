{
  "version": 1,
  "steps": [
    {"action": "capture_hinge_baseline", "position": "closed"},
    {"action": "fold", "position": "closed"},
    {"action": "wait_hinge", "position": "closed", "timeout": 30},
    {"action": "terminate", "bundle_id": "com.bvolpato.limulator.counterlab"},
    {"action": "launch", "bundle_id": "com.bvolpato.limulator.counterlab"},
    {"action": "wait_text", "text": "Counter Lab", "timeout": 120},
    {"action": "scroll_to_element", "identifier": "counterlab.reset"},
    {"action": "tap_element", "identifier": "counterlab.reset"},
    {"action": "scroll_to_element", "identifier": "counterlab.counter.value", "direction": "up"},
    {"action": "wait_text", "text": "0", "identifier": "counterlab.counter.value", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.device.point_size"},
    {"action": "wait_text", "text": "Screen size, 466 × 678 pt", "identifier": "counterlab.device.point_size", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.device.display_scale"},
    {"action": "wait_text", "text": "Display scale, 3×", "identifier": "counterlab.device.display_scale", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.increment"},
    {"action": "tap_element", "identifier": "counterlab.increment"},
    {"action": "scroll_to_element", "identifier": "counterlab.counter.value", "direction": "up"},
    {"action": "wait_text", "text": "1", "identifier": "counterlab.counter.value", "exact": true},

    {"action": "capture_hinge_baseline", "position": "book"},
    {"action": "fold", "position": "book"},
    {"action": "wait_hinge", "position": "book", "timeout": 30},
    {"action": "scroll_to_element", "identifier": "counterlab.device.point_size"},
    {"action": "wait_text", "text": "Screen size, 951 × 669 pt", "identifier": "counterlab.device.point_size", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.device.display_scale"},
    {"action": "wait_text", "text": "Display scale, 3×", "identifier": "counterlab.device.display_scale", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.increment"},
    {"action": "tap_element", "identifier": "counterlab.increment"},
    {"action": "scroll_to_element", "identifier": "counterlab.counter.value", "direction": "up"},
    {"action": "wait_text", "text": "2", "identifier": "counterlab.counter.value", "exact": true},

    {"action": "capture_hinge_baseline", "position": "open"},
    {"action": "fold", "position": "open"},
    {"action": "wait_hinge", "position": "open", "timeout": 30},
    {"action": "scroll_to_element", "identifier": "counterlab.device.point_size"},
    {"action": "wait_text", "text": "Screen size, 951 × 669 pt", "identifier": "counterlab.device.point_size", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.device.display_scale"},
    {"action": "wait_text", "text": "Display scale, 3×", "identifier": "counterlab.device.display_scale", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.increment"},
    {"action": "tap_element", "identifier": "counterlab.increment"},
    {"action": "scroll_to_element", "identifier": "counterlab.counter.value", "direction": "up"},
    {"action": "wait_text", "text": "3", "identifier": "counterlab.counter.value", "exact": true},

    {"action": "capture_hinge_baseline", "position": "closed"},
    {"action": "fold", "position": "closed"},
    {"action": "wait_hinge", "position": "closed", "timeout": 30},
    {"action": "scroll_to_element", "identifier": "counterlab.device.point_size"},
    {"action": "wait_text", "text": "Screen size, 466 × 678 pt", "identifier": "counterlab.device.point_size", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.device.display_scale"},
    {"action": "wait_text", "text": "Display scale, 3×", "identifier": "counterlab.device.display_scale", "exact": true},
    {"action": "scroll_to_element", "identifier": "counterlab.counter.value", "direction": "up"},
    {"action": "wait_text", "text": "3", "identifier": "counterlab.counter.value", "exact": true}
  ]
}
