{
  "version": 1,
  "steps": [
    {"action": "launch", "bundle_id": "com.bvolpato.limulator.counterlab"},
    {"action": "wait_text", "text": "Counter Lab", "timeout": 120},
    {"action": "tap_element", "identifier": "counterlab.network.check"},
    {"action": "wait_text", "text": "HTTP 200", "identifier": "counterlab.network.status", "timeout": 60},
    {"action": "screenshot", "name": "01-https-connected.png"}
  ]
}
